{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": { "@shared/*": ["./src/shared/*"] }
	},
	"include": [
		"electron.vite.config.ts",
		"vitest.config.ts",
		"playwright.config.ts",
		"e2e/**/*",
		"src/renderer/src/types/gifenc.d.ts",
		"src/main/**/*",
		"src/preload/**/*",
		"src/shared/**/*"
	]
}
